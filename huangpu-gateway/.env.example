# 黄埔城更 demo 网关配置模板——复制为 .env 后填写（.env 含真实 key，不入库）

# 网关监听端口
PORT=8090

# 上游 WeKnora 后端地址（docker-compose app 服务，默认 8080）
WEKNORA_URL=http://127.0.0.1:8080

# WeKnora scoped API Key（WebUI → 密钥管理创建；只放这里，前端不再持有）
WEKNORA_API_KEY=sk-xxxx

# 网关令牌签名密钥（demo 默认值可用；生产换随机值）
GATEWAY_TOKEN_SECRET=hp-gateway-demo-secret

# 置 1 模拟"引擎不可用"：网关不代调引擎，AI 自算数字将被对账拒收（数值铁律演示）
GATEWAY_ENGINE_DISABLED=
