# 复制为 oss.env 后填写（oss.env 不会提交到 Git）
#
# 阿里云 OSS 控制台：https://oss.console.aliyun.com/
# 1. 创建 Bucket（读写权限建议选「公共读」或后续用 CDN）
# 2. 基础设置 → 静态页面 → 默认首页 index.html
# 3. RAM 访问控制 → 用户 → 创建 AccessKey

# 必填（region 由 endpoint 自动推导，也可单独指定 OSS_REGION=cn-beijing）
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# 可选：上传到 Bucket 内的子目录，留空表示根目录
OSS_PREFIX=

# 必填（2025 年后中国内地 Bucket）：已备案的自定义域名
# OSS 默认域名会强制下载 HTML，oss-website 域名也可能不可用
# 控制台: Bucket → 传输管理 → 域名管理 → 绑定域名 → DNS 添加 CNAME
OSS_WEBSITE_URL=http://sandbox.example.com
